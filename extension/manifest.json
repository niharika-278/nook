{
  "manifest_version": 3,
  "name": "Nook — Save to your little corner",
  "version": "0.1.0",
  "description": "Save the current page to your Nook library.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Save to Nook",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_page": "options.html"
}
